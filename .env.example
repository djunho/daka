# --- Public endpoint -----------------------------------------------------
DOMAIN=localhost
NGINX_PORT=8443

# --- MariaDB -------------------------------------------------------------
MYSQL_DATABASE=daka
MYSQL_USER=daka_user
MYSQL_PASSWORD=change_me_app
MYSQL_ROOT_PASSWORD=change_me_root

# --- Database connection (used by the backend) ---------------------------
DB_HOST=db
DB_PORT=3306

# --- Authentication ------------------------------------------------------
SESSION_TTL_HOURS=168
BCRYPT_ROUNDS=12

# --- Google OAuth -------------------------------------------------------
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=https://localhost:8443/api/auth/google/callback
OAUTH_STATE_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=https://localhost:8443

# --- Prometheus basic auth -----------------------------------------------
PROM_USER=daka
PROM_PASSWORD=change_me_prom

# --- Grafana admin -------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# --- mysqld-exporter -----------------------------------------------------
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=change_me_exporter