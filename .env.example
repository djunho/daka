# Copy to .env (in this same srcs/ folder) and fill it in.
# .env is NEVER committed to git — see .gitignore.

# MariaDB
# ==========================
MYSQL_DATABASE=name
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=password

# Database connection (used by the backend)
# ==========================
# DB_HOST is the service name in docker-compose, not an IP.
DB_HOST=name
DB_PORT=123 #your real db port

# Public port
# ==========================
NGINX_PORT=321 #your real nginx port
