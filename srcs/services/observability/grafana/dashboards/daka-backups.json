{
  "uid": "daka-backups",
  "title": "Daka — Backups",
  "tags": [
    "daka",
    "backups"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Last verified backup",
      "description": "Time at which the last backup finished and passed the restore check.",
      "datasource": {
        "type": "prometheus",
        "uid": "daka-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "daka-prometheus"
          },
          "expr": "backup_last_success_timestamp{job=\"node\"} * 1000",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "noValue": "No verified backup"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "none"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Time since last verified backup",
      "description": "The backup is overdue after 26 hours.",
      "datasource": {
        "type": "prometheus",
        "uid": "daka-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "daka-prometheus"
          },
          "expr": "time() - backup_last_success_timestamp{job=\"node\"}",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "noValue": "No verified backup",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 93600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Last backup duration",
      "description": "Time spent creating, verifying and rotating the last successful backup.",
      "datasource": {
        "type": "prometheus",
        "uid": "daka-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "daka-prometheus"
          },
          "expr": "backup_duration_seconds{job=\"node\"}",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No verified backup"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "none"
      }
    }
  ]
}
